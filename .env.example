# Copy to .env for local development. Never put real values in Git.
# Supabase transaction pooler URL for the separate pomodoro-matias project only.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require
POMODORO_ALLOWED_USER_ID=YOUR_SUPABASE_AUTH_USER_UUID
POMODORO_ACCESS_PASSWORD=SET_A_LONG_UNIQUE_PASSWORD_IN_YOUR_SECRET_STORE
POMODORO_SESSION_SECRET=GENERATE_AT_LEAST_32_RANDOM_BYTES

# Copy to .env for local development. Never put real values in Git.
SUPABASE_URL=https://YOUR-POMODORO-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_ANON_KEY
# Supabase transaction pooler URL (port 6543, SSL required) or the project's direct URL.
POMODORO_ALLOWED_USER_ID=YOUR_SUPABASE_AUTH_USER_UUID
